# Reference docker compose defaults.
#
# The repository also includes a public `.env` with these same non-secret smoke
# test values. Keep this file as a reference if you customize `.env` locally.

COORDINATOR_PORT=10800
LEARNER_PORT=6600
DDRL_LEARNER_DEVICE=auto

DDRL_WORKER_NUM_SIM_INSTANCES=4
DDRL_WORKER_NUM_RAYCAST_THREADS=0
DDRL_WORKER_ENABLE_VISUALIZATION=false
DDRL_WORKER_REAL_TIME_FACTOR=1.0

# Used only by the optional `worker-viz` profile.
DISPLAY=:0
XAUTHORITY=/tmp/.Xauthority
