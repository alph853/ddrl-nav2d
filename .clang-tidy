Checks: >
  -*,
  bugprone-*,
  performance-*,
  portability-*,
  modernize-*,
  readability-identifier-naming,
  readability-*,
  cppcoreguidelines-interfaces-global-init,
  cppcoreguidelines-non-private-member-variables-in-classes,
  cppcoreguidelines-avoid-c-arrays,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,
  -readability-isolate-declaration,
  -bugprone-easily-swappable-parameters,
  -readability-math-missing-parentheses,
  -modernize-use-designated-initializers,
  -readability-avoid-nested-conditional-operator,
  -readability-magic-numbers,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -bugprone-branch-clone,
  -readability-uppercase-literal-suffix

HeaderFilterRegex: '^(?!.*(third_party|external|deps|build)).*'

WarningsAsErrors: ''
FormatStyle: none

CheckOptions:
  # ---- Naming (the important part) ----
  - { key: readability-identifier-naming.NamespaceCase,           value: lower_case }
  - { key: readability-identifier-naming.TypeCase,                 value: CamelCase }   # classes/structs/enums
  - { key: readability-identifier-naming.EnumConstantCase,         value: UPPER_CASE }
  - { key: readability-identifier-naming.FunctionCase,             value: lower_case }  # free functions
  - { key: readability-identifier-naming.MethodCase,               value: lower_case }  # member functions
  - { key: readability-identifier-naming.VariableCase,             value: lower_case }
  - { key: readability-identifier-naming.MemberCase,               value: lower_case }
  - { key: readability-identifier-naming.PrivateMemberSuffix,      value: _ }           # counter_ style
  - { key: readability-identifier-naming.ProtectedMemberSuffix,    value: _ }
  - { key: readability-identifier-naming.GlobalConstantPrefix,     value: k }           # kPi, kTickMs
  - { key: readability-identifier-naming.GlobalConstantCase,       value: CamelCase }
  - { key: readability-identifier-naming.ConstexprVariablePrefix,  value: k }
  - { key: readability-identifier-naming.ConstexprVariableCase,    value: CamelCase }
  - { key: readability-identifier-naming.MacroDefinitionCase,      value: UPPER_CASE }
  - { key: readability-identifier-naming.TemplateParameterCase,    value: CamelCase }
  - { key: readability-identifier-naming.ClassCase,                value: CamelCase }
  - { key: readability-identifier-naming.StructCase,               value: CamelCase }

  # - { key: modernize-use-trailing-return-type.ReplacementTypeName, value: 'auto' }
